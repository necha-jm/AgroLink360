<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Animated Gradient Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp"
            android:gravity="center_horizontal">

            <!-- App Icon Placeholder - Add your logo here -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_app_icon"
                android:contentDescription="App Logo"
                android:elevation="4dp"
                android:layout_marginBottom="16dp" />

            <!-- App Name with Gradient Text Effect -->
            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AgroLink360"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/green_dark"
                android:letterSpacing="0.02"
                android:elevation="2dp"
                android:layout_marginBottom="8dp" />

            <!-- Tagline with Animation -->
            <TextView
                android:id="@+id/tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Farming Network"
                android:textSize="16sp"
                android:textColor="@color/gray_dark"
                android:letterSpacing="0.01" />

            <!-- Decorative Line -->
            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/gradient_divider" />
        </LinearLayout>

        <!-- Section Header with Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chagua Jukumu Lako"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_role_selector"
                android:contentDescription="Role Icon"
                app:tint="@color/green_dark" />
        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chagua jinsi unavyotaka kutumia AgroLink360"
            android:textSize="14sp"
            android:textColor="@color/gray_medium"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="4dp" />

        <!-- Selected Role Card with Status -->
        <androidx.cardview.widget.CardView
            android:id="@+id/selected_role_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/green_light_bg"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/green_dark" />

                <TextView
                    android:id="@+id/selected_role_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text=""
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected"
                    android:textSize="12sp"
                    android:textColor="@color/green_dark"
                    android:background="@drawable/selected_badge"
                    android:padding="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Farmer Option Card - Enhanced -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_farmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_elevation"
            app:cardPreventCornerOverlap="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <!-- Icon Container -->
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/icon_background_green"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_farmer"
                        android:contentDescription="Farmer Icon"
                        app:tint="@color/green_dark" />
                </LinearLayout>

                <!-- Text Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mkulima"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_dark"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lima mazao na uunganishe na masoko"
                        android:textSize="14sp"
                        android:textColor="@color/gray_dark"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Selection Indicator -->
                <ImageView
                    android:id="@+id/indicator_farmer"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_unselected"
                    android:contentDescription="Selection Indicator" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Business Option Card - Enhanced -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_business"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <!-- Icon Container -->
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/icon_background_blue"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_business"
                        android:contentDescription="Business Icon"
                        app:tint="@color/blue_dark" />
                </LinearLayout>

                <!-- Text Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mfanyabiashara"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_dark"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nunua mazao na uunganishe na wakulima"
                        android:textSize="14sp"
                        android:textColor="@color/gray_dark"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Selection Indicator -->
                <ImageView
                    android:id="@+id/indicator_business"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_unselected"
                    android:contentDescription="Selection Indicator" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Expert Option Card - Enhanced -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_expert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <!-- Icon Container -->
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/icon_background_orange"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_expert"
                        android:contentDescription="Expert Icon"
                        app:tint="@color/orange_dark" />
                </LinearLayout>

                <!-- Text Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mtaalamu"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange_dark"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shiriki ujuzi wa kilimo"
                        android:textSize="14sp"
                        android:textColor="@color/gray_dark"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Selection Indicator -->
                <ImageView
                    android:id="@+id/indicator_expert"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_unselected"
                    android:contentDescription="Selection Indicator" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Continue Button with Animation Effect -->
        <Button
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Endelea"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/button_gradient_background"
            android:layout_marginTop="8dp"
            android:enabled="true"
            android:stateListAnimator="@animator/button_elevation"
            android:elevation="4dp"
            android:translationZ="2dp" />

        <!-- Footer Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2024 AgroLink360 - Kuunganisha Kilimo na Teknolojia"
            android:textSize="12sp"
            android:textColor="@color/gray_light"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>